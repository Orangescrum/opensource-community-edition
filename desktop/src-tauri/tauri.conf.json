{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orangescrum",
  "version": "0.1.0",
  "identifier": "com.andolasoft.orangescrum.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Andolasoft Inc.",
    "copyright": "Copyright (c) 2026 Andolasoft Inc.",
    "category": "Productivity",
    "shortDescription": "Orangescrum desktop client",
    "longDescription": "Desktop client for a self-hosted Orangescrum Community Edition server.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
