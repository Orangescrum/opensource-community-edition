# User-uploaded files live here. Under no circumstances should anything in this
# tree be executed by the server — it must only ever be served as inert bytes.
# This is the definitive backstop behind the upload extension allowlist: even if
# a dangerous extension slipped through, PHP (and any other handler) will not run.
#
# Do NOT add php_admin_flag/php_admin_value here. Apache only accepts those in
# server or virtual-host config; in .htaccess they raise
#   "php_admin_flag not allowed here"
# which makes Apache return 500 for EVERY request under /files/ — no avatar,
# project logo or attachment can be served. The directives below achieve the
# same result and are valid in this context.

# Refuse to serve anything that maps to a code handler, regardless of how
# PHP/CGI is wired up on the host.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phtm|pht|phar|phps|inc|cgi|pl|py|rb|sh|asp|aspx|jsp|jspx|cfm|shtml|svg|svgz|htaccess|htm|html|xhtml)$">
    Require all denied
</FilesMatch>

# Strip any handler/type association and force downloads to be treated as data.
RemoveHandler .php .phtml .phtm .pht .phar .phps .cgi .pl .py .rb .sh
RemoveType .php .phtml .phtm .pht .phar .phps
SetHandler none
