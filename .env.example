# Copy to .env and adjust. docker compose reads this file automatically.
# All values are optional — the defaults below match docker-compose.yml.

# Host port the app is published on: browse http://localhost:${APP_PORT}
APP_PORT=8080

# Public URL the browser uses. MUST match APP_PORT (and the scheme/host).
# Behind an HTTPS reverse proxy use e.g. https://app.example.com
FULL_BASE_URL=http://localhost:8080

# Database credentials (used by both the app and the bundled postgres service)
DB_NAME=orangescrum
DB_USERNAME=orangescrum
DB_PASSWORD=orangescrum

# Sessions / CSRF. Set SESSION_COOKIE_SECURE=true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=ORANGESCRUM_SESSID
# Leave empty for the exact host only. Set with a leading dot (.example.com)
# to share the session across subdomains.
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_NAME=orangescrum_csrf

# Cache engine: file (default) or redis/memcached if configured.
CACHE_ENGINE=file

# Show the in-app "Upgrade" entry and the /upgrade and /add-ons pages, which
# describe the paid self-hosted editions and add-ons. Owners and admins only.
# Set to false to remove them entirely — nothing else changes.
SHOW_UPGRADE_CTA=true

# Persisted security salt for hashing / CSRF / sessions. Set a unique value so
# sessions survive container/app_local rebuilds (generate: openssl rand -hex 32).
# Leave blank to let the installer generate a random per-install salt instead.
# SECURITY_SALT=

