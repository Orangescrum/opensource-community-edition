{
  "name": "@orangescrum/email-templating",
  "version": "1.0.0",
  "description": "Vue 3 + Vuetify 3 Email Templating Plugin",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "watch": "vite build --watch",
