    "vue": "^3.4.21",
    "vuetify": "^3.5.10"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.8.3",
    "sass": "^1.71.1",
    "vite": "^6.1.7"
  }
}
